# Required for AI analysis and clustering scripts.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_FORMAT=

# Optional. Used for production canonical URLs, robots.txt, and sitemap.xml.
SITE_URL=

# Optional. Overrides the upstream README raw URL used by npm run fetch.
SOURCE_README_URL=

# Optional. Controls npm run check-links concurrency. Default: 12.
CHECK_LINKS_CONCURRENCY=
