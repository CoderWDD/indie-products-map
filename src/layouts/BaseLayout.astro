---
import "../styles/global.css";
import { createAbsoluteUrl, normalizePathname } from "../lib/site";

type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
};

const {
  title,
  description = "非官方独立产品灵感浏览器。",
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonicalUrl = createAbsoluteUrl(normalizePathname(canonicalPath), Astro.site ?? undefined);
const currentPath = normalizePathname(Astro.url.pathname);
const navigation = [
  { href: "/", label: "首页" },
  { href: "/projects", label: "项目" },
  { href: "/about", label: "关于" },
];

function isActivePath(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f8f3" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-950">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-slate-950" href="#main-content">
      跳到主要内容
    </a>
    <header class="border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-col gap-5 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <a href="/" class="group inline-flex w-fit items-center gap-3 text-slate-950" aria-label="Indie Products Map 首页">
          <span class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-200 bg-slate-950 font-data text-sm text-white shadow-sm">
            IP
          </span>
          <span>
            <span class="font-display block text-xl font-semibold tracking-normal">Indie Products Map</span>
            <span class="block text-xs text-slate-500">中文独立产品观察台</span>
          </span>
        </a>
        <nav class="flex w-fit flex-wrap gap-2 rounded-md border border-slate-200 bg-slate-50 p-1 text-sm text-slate-600" aria-label="主导航">
          {
            navigation.map((item) => {
              const active = isActivePath(item.href);
              return (
                <a
                  class:list={[
                    "rounded-md px-3 py-2",
                    active
                      ? "bg-white text-slate-950 shadow-sm"
                      : "hover:bg-white hover:text-slate-950",
                  ]}
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <div class="border-b border-slate-200 bg-white/80">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-3 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
        <p>
          非官方项目。原始信息来自 README 和官网摘要，AI 内容只作为产品灵感推测。
        </p>
        <a class="w-fit text-slate-700 underline decoration-slate-300 hover:text-slate-950" href="/about">
          查看边界说明
        </a>
      </div>
    </div>
    <div id="main-content">
      <slot />
    </div>
    <footer class="border-t border-slate-200 bg-white/90">
      <div class="mx-auto grid max-w-6xl gap-5 px-6 py-8 text-sm text-slate-500 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <p class="font-display text-lg font-semibold text-slate-950">Indie Products Map</p>
          <p class="mt-2 max-w-2xl">
            用结构化数据和 AI 推测辅助观察中文独立产品。项目收录和修改请优先回到原 GitHub 仓库。
          </p>
        </div>
        <div class="flex flex-wrap gap-3 sm:justify-end">
          <a class="hover:text-slate-950" href="/projects">浏览项目</a>
          <a class="hover:text-slate-950" href="/about">关于本站</a>
          <a class="hover:text-slate-950" href="https://github.com/1c7/chinese-independent-developer" target="_blank" rel="noreferrer">
            原始仓库
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
