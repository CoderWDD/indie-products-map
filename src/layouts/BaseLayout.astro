---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "非官方独立产品灵感浏览器。" } = Astro.props;
const navigation = [
  { href: "/", label: "首页" },
  { href: "/projects", label: "项目" },
  { href: "/patterns", label: "模式" },
  { href: "/about", label: "关于" },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-950">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <a href="/" class="text-lg font-semibold tracking-normal">Indie Products Map</a>
        <nav class="flex flex-wrap gap-4 text-sm text-slate-600" aria-label="主导航">
          {navigation.map((item) => <a class="hover:text-slate-950" href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <div class="border-b border-amber-200 bg-amber-50">
      <div class="mx-auto max-w-6xl px-6 py-3 text-sm text-amber-900">
        本站是基于 1c7/chinese-independent-developer 的非官方项目。原始信息来自 README 和官网摘要；AI 分析均为推测，仅供灵感参考。
      </div>
    </div>
    <slot />
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-slate-500">
        非官方独立产品灵感浏览器。项目收录和修改请优先回到原 GitHub 仓库。
      </div>
    </footer>
  </body>
</html>
