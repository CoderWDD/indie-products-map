---
import "../styles/global.css";
import { ArrowUpRight, Database, Info, Search } from "lucide-react";
import SiteLogo from "../components/SiteLogo.astro";
import { createAbsoluteUrl, normalizePathname } from "../lib/site";

type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
};

const {
  title,
  description = "从中文独立产品里，找下一次动手的方向。",
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const siteSlogan = "从中文独立产品里，找下一次动手的方向。";
const canonicalUrl = createAbsoluteUrl(normalizePathname(canonicalPath), Astro.site ?? undefined);
const currentPath = normalizePathname(Astro.url.pathname);
const navigation = [
  { href: "/", label: "首页" },
  { href: "/projects", label: "项目" },
  { href: "/about", label: "关于" },
];

function isActivePath(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f8f3" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-950">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-slate-950" href="#main-content">
      跳到主要内容
    </a>
    <header class="border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto grid max-w-6xl gap-4 px-6 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
        <a href="/" class="group inline-flex min-w-0 items-center gap-3 text-slate-950" aria-label="Indie Products Map 首页">
          <SiteLogo />
        </a>
        <nav class="grid grid-cols-3 gap-1 rounded-md border border-slate-200 bg-slate-50 p-1 text-center text-sm text-slate-600 sm:flex sm:w-fit sm:flex-wrap" aria-label="主导航">
          {
            navigation.map((item) => {
              const active = isActivePath(item.href);
              return (
                <a
                  class:list={[
                    "rounded-md px-3 py-2",
                    active
                      ? "bg-white text-slate-950 shadow-sm"
                      : "hover:bg-white hover:text-slate-950",
                  ]}
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <div class="border-b border-slate-200 bg-white/80">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-3 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
        <p class="flex min-w-0 items-start gap-2 leading-6">
          <Info aria-hidden="true" className="mt-1 h-4 w-4 shrink-0 text-emerald-700" />
          <span>
          非官方项目。原始信息来自 README 和官网摘要，AI 内容只作为产品灵感推测。
          </span>
        </p>
        <a class="inline-flex w-fit shrink-0 items-center gap-1 text-slate-700 underline decoration-slate-300 hover:text-slate-950" href="/about">
          查看边界说明
          <ArrowUpRight aria-hidden="true" className="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
    <div id="main-content">
      <slot />
    </div>
    <footer class="border-t border-slate-200 bg-white/90">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 py-8 text-sm text-slate-500 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div class="min-w-0">
          <div class="flex items-center gap-3">
            <SiteLogo compact />
          </div>
          <p class="mt-4 max-w-2xl leading-6">
            {siteSlogan} 用结构化数据和 AI 推测辅助观察中文独立产品。项目收录和修改请优先回到原 GitHub 仓库。
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3 lg:min-w-[440px]">
          <a class="flex items-center justify-between gap-3 rounded-md border border-slate-200 bg-white px-4 py-3 font-medium text-slate-700 hover:border-slate-500 hover:text-slate-950" href="/projects">
            <span class="inline-flex items-center gap-2">
              <Search aria-hidden="true" className="h-4 w-4 text-emerald-700" />
              浏览项目
            </span>
            <ArrowUpRight aria-hidden="true" className="h-4 w-4 shrink-0" />
          </a>
          <a class="flex items-center justify-between gap-3 rounded-md border border-slate-200 bg-white px-4 py-3 font-medium text-slate-700 hover:border-slate-500 hover:text-slate-950" href="/about">
            <span class="inline-flex items-center gap-2">
              <Info aria-hidden="true" className="h-4 w-4 text-emerald-700" />
              关于本站
            </span>
            <ArrowUpRight aria-hidden="true" className="h-4 w-4 shrink-0" />
          </a>
          <a class="flex items-center justify-between gap-3 rounded-md border border-slate-200 bg-white px-4 py-3 font-medium text-slate-700 hover:border-slate-500 hover:text-slate-950" href="https://github.com/1c7/chinese-independent-developer" target="_blank" rel="noreferrer">
            <span class="inline-flex items-center gap-2">
              <Database aria-hidden="true" className="h-4 w-4 text-emerald-700" />
              原始仓库
            </span>
            <ArrowUpRight aria-hidden="true" className="h-4 w-4 shrink-0" />
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
