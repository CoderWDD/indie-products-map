---
import BaseLayout from "../layouts/BaseLayout.astro";
import { latestUpdate, patterns, projects } from "../lib/data";

const analyzedCount = projects.filter((project) => project.aiAnalysis?.status === "available").length;
const updatedAt = latestUpdate.updatedAt ?? "尚未更新";
---

<BaseLayout title="Indie Products Map" description="基于原始 README 和 AI 推测的非官方独立产品灵感浏览器。">
  <main class="mx-auto max-w-6xl px-6 py-10">
    <section class="max-w-3xl">
      <p class="text-sm font-medium text-emerald-700">产品模式地图</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-normal text-slate-950">独立产品灵感浏览器</h1>
      <p class="mt-4 text-lg leading-8 text-slate-700">
        首页以产品模式为主入口。当前页面先提供静态骨架，搜索和筛选交互会在后续任务卡实现。
      </p>
      <form class="mt-8" action="/projects" method="get">
        <label class="sr-only" for="q">搜索项目</label>
        <input
          id="q"
          name="q"
          class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base shadow-sm outline-none focus:border-emerald-600"
          placeholder="搜索项目、作者、简介或产品模式"
        />
      </form>
    </section>

    <section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="基础统计">
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">总项目数</div>
        <div class="mt-2 text-3xl font-semibold">{projects.length}</div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">产品模式数量</div>
        <div class="mt-2 text-3xl font-semibold">{patterns.length}</div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">有 AI 分析项目数</div>
        <div class="mt-2 text-3xl font-semibold">{analyzedCount}</div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">最近更新时间</div>
        <div class="mt-2 text-base font-semibold">{updatedAt}</div>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-normal">产品模式</h2>
        <a class="text-sm text-emerald-700 hover:text-emerald-900" href="/patterns">查看模式页</a>
      </div>
      {patterns.length === 0 ? (
        <div class="mt-5 rounded-md border border-dashed border-slate-300 bg-white p-8 text-slate-600">
          暂无产品模式数据。运行 AI 分析和聚类后，这里会展示模式卡片矩阵。
        </div>
      ) : (
        <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {patterns.map((pattern) => (
            <a class="rounded-md border border-slate-200 bg-white p-5 shadow-sm hover:border-emerald-300" href={`/patterns/${pattern.slug}`}>
              <div class="text-sm text-slate-500">{pattern.icon}</div>
              <h3 class="mt-3 text-lg font-semibold">{pattern.name}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-700">{pattern.description}</p>
              <p class="mt-4 text-sm text-slate-500">{pattern.projectSlugs.length} 个项目</p>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
