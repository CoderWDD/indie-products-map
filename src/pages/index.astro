---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { latestUpdate, projects } from "../lib/data";

const analyzedCount = projects.filter((project) => project.aiAnalysis?.status === "available").length;
const activeProjects = projects.filter((project) => project.inSource).length;
const unanalyzedCount = projects.length - analyzedCount;
const recentProjects = [...projects]
  .filter((project) => project.aiAnalysis?.status === "available")
  .sort((a, b) => b.sourceOrder - a.sourceOrder)
  .slice(0, 6);
const latestAddedProjects = latestUpdate.changes.added
  .flatMap((project) => (project.projectSlug ? [{ ...project, projectSlug: project.projectSlug }] : []))
  .slice(0, 5);
const analysisCoverage = projects.length > 0 ? Math.round((analyzedCount / projects.length) * 100) : 0;
const productTypeCounts = new Map<string, number>();

for (const project of projects) {
  if (project.aiAnalysis?.status !== "available") {
    continue;
  }

  for (const type of project.aiAnalysis.productTypes) {
    productTypeCounts.set(type, (productTypeCounts.get(type) ?? 0) + 1);
  }
}

const topProductTypes = [...productTypeCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

function formatDate(value: string | null) {
  if (!value) {
    return "尚未更新";
  }

  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(new Date(value));
}

const updatedAt = formatDate(latestUpdate.updatedAt);
---

<BaseLayout title="Indie Products Map" description="基于原始 README 和 AI 推测的非官方独立产品灵感浏览器。">
  <main>
    <section class="mx-auto grid max-w-6xl gap-8 px-6 pb-12 pt-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-end lg:pt-16">
      <div class="max-w-3xl">
        <p class="font-data text-xs uppercase tracking-[0.18em] text-emerald-700">README / AI notes / product clues</p>
        <h1 class="font-display mt-5 text-4xl font-semibold leading-tight tracking-normal text-slate-950 sm:text-6xl">
          中文独立产品观察台
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">
          把原始 README 项目列表整理成可搜索、可筛选、可继续追问的产品样本库。原始信息和 AI 推测分开呈现，适合用来找方向、拆定位、看人群和产品形态。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-md bg-slate-950 px-5 py-3 text-sm font-medium text-white hover:bg-slate-800" href="/projects">
            浏览全部项目
          </a>
          <a class="rounded-md border border-slate-200 bg-white px-5 py-3 text-sm font-medium text-slate-700 hover:text-slate-950" href="/about">
            查看数据边界
          </a>
        </div>
      </div>

      <form class="rounded-md border border-slate-200 bg-white p-5 shadow-sm" action="/projects" method="get">
        <label class="text-sm font-semibold text-slate-950" for="q">从一个关键词开始</label>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          搜索项目名、作者、原始简介或 AI 摘要。
        </p>
        <input
          id="q"
          name="q"
          class="mt-4 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base outline-none focus:border-emerald-600"
          placeholder="例如：PDF、Chrome、写作、出海"
        />
        <button class="mt-3 w-full rounded-md bg-slate-950 px-4 py-3 text-sm font-medium text-white hover:bg-slate-800" type="submit">
          搜索项目
        </button>
      </form>
    </section>

    <section class="border-y border-slate-200 bg-white/75" aria-label="数据概况">
      <div class="mx-auto grid max-w-6xl gap-px px-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="py-6">
          <div class="text-sm text-slate-500">收录项目</div>
          <div class="font-data mt-2 text-4xl font-semibold text-slate-950">{projects.length}</div>
        </div>
        <div class="py-6">
          <div class="text-sm text-slate-500">仍在原列表</div>
          <div class="font-data mt-2 text-4xl font-semibold text-slate-950">{activeProjects}</div>
        </div>
        <div class="py-6">
          <div class="text-sm text-slate-500">AI 分析覆盖</div>
          <div class="font-data mt-2 text-4xl font-semibold text-slate-950">{analysisCoverage}%</div>
        </div>
        <div class="py-6">
          <div class="text-sm text-slate-500">最近更新</div>
          <div class="font-data mt-3 text-xl font-semibold text-slate-950">{updatedAt}</div>
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-6 px-6 py-12 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-sm font-medium text-emerald-700">观察维度</p>
        <h2 class="font-display mt-2 text-3xl font-semibold tracking-normal text-slate-950">先看产品形态，再进入项目细节</h2>
        <p class="mt-4 leading-7 text-slate-700">
          当前版本不再维护高成本的产品模式地图。首页改为展示由项目级 AI 分析沉淀出的产品类型，让你先感知样本分布，再进入项目列表做搜索和筛选。
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          topProductTypes.map(([type, count]) => (
            <a
              class="flex items-center justify-between rounded-md border border-slate-200 bg-white px-4 py-3 shadow-sm hover:border-slate-300 hover:text-slate-950"
              href={`/projects?q=${encodeURIComponent(type)}`}
            >
              <span class="text-sm font-medium text-slate-950">{type}</span>
              <span class="font-data text-sm text-slate-500">{count}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white/70">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="text-sm font-medium text-emerald-700">本次数据状态</p>
          <h2 class="font-display mt-2 text-3xl font-semibold tracking-normal text-slate-950">更新后还有 {unanalyzedCount} 个项目暂无可用 AI 分析</h2>
          <p class="mt-4 leading-7 text-slate-700">
            这些项目仍会展示原始 README 信息。AI 内容只作为产品灵感推测，不替代项目事实，也不用于判断项目成败。
          </p>
        </div>
        <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center justify-between gap-4 border-b border-slate-200 pb-3">
            <h3 class="text-sm font-semibold text-slate-950">最近新增记录</h3>
            <a class="text-sm text-emerald-700 hover:text-emerald-900" href="/projects">全部项目</a>
          </div>
          <ol class="mt-4 space-y-3">
            {
              latestAddedProjects.map((project) => (
                <li class="flex items-center justify-between gap-4 text-sm">
                  <a class="truncate font-medium text-slate-950 hover:text-emerald-700" href={`/projects/${project.projectSlug}`}>
                    {project.name}
                  </a>
                  <span class="font-data shrink-0 text-xs text-slate-500">{project.projectSlug}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-medium text-emerald-700">最近收录</p>
          <h2 class="font-display mt-2 text-3xl font-semibold tracking-normal text-slate-950">从新样本开始探索</h2>
        </div>
        <a class="w-fit text-sm text-emerald-700 hover:text-emerald-900" href="/projects">查看全部项目</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {recentProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
</BaseLayout>
