---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { latestUpdate, projects } from "../lib/data";

const analyzedCount = projects.filter((project) => project.aiAnalysis?.status === "available").length;
const activeProjects = projects.filter((project) => project.inSource).length;
const recentProjects = [...projects]
  .filter((project) => project.aiAnalysis?.status === "available")
  .sort((a, b) => b.sourceOrder - a.sourceOrder)
  .slice(0, 6);
const updatedAt = latestUpdate.updatedAt ?? "尚未更新";
---

<BaseLayout title="Indie Products Map" description="基于原始 README 和 AI 推测的非官方独立产品灵感浏览器。">
  <main class="mx-auto max-w-6xl px-6 py-10">
    <section class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <p class="text-sm font-medium text-emerald-700">非官方独立产品灵感库</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-normal text-slate-950 sm:text-5xl">
          浏览中文独立开发者正在做的产品
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">
          基于原始 README、官网摘要和 AI 推测分析，快速查看项目定位、目标用户、产品类型和可借鉴点。
        </p>
      </div>
      <form class="rounded-md border border-slate-200 bg-white p-4 shadow-sm" action="/projects" method="get">
        <label class="text-sm font-medium text-slate-700" for="q">搜索项目</label>
        <input
          id="q"
          name="q"
          class="mt-2 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base outline-none focus:border-emerald-600"
          placeholder="搜索项目、作者、简介或 AI 摘要"
        />
        <button class="mt-3 w-full rounded-md bg-slate-950 px-4 py-3 text-sm font-medium text-white hover:bg-slate-800" type="submit">
          搜索项目
        </button>
      </form>
    </section>

    <section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="基础统计">
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">总项目数</div>
        <div class="mt-2 text-3xl font-semibold">{projects.length}</div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">仍在原列表</div>
        <div class="mt-2 text-3xl font-semibold">{activeProjects}</div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">有 AI 分析项目数</div>
        <div class="mt-2 text-3xl font-semibold">{analyzedCount}</div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-4">
        <div class="text-sm text-slate-500">最近更新时间</div>
        <div class="mt-2 text-base font-semibold">{updatedAt}</div>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-emerald-700">最近收录</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-normal">从新项目开始探索</h2>
        </div>
        <a class="text-sm text-emerald-700 hover:text-emerald-900" href="/projects">查看全部项目</a>
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {recentProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
</BaseLayout>
