---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  homepageSummaryByProjectSlug,
  linkStatusByProjectSlug,
  projects,
} from "../../lib/data";
import type { Project } from "../../lib/types";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: Project;
};

const { project } = Astro.props;
const linkStatus = linkStatusByProjectSlug.get(project.slug) ?? null;
const homepageSummary = homepageSummaryByProjectSlug.get(project.slug) ?? null;
const analysis = project.aiAnalysis;
---

<BaseLayout
  title={`${project.name} | Indie Products Map`}
  description={project.rawDescription || `${project.name} 的独立产品详情。`}
  canonicalPath={`/projects/${project.slug}/`}
>
  <main class="mx-auto max-w-6xl px-6 py-10">
    <div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
      <article>
        <p class="text-sm font-medium text-emerald-700">项目详情</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-normal">{project.name}</h1>
        <p class="mt-4 text-lg leading-8 text-slate-700">{project.rawDescription || "原始简介暂缺。"}</p>

        <section class="mt-8 rounded-md border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-semibold tracking-normal">原始信息</h2>
          <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-slate-500">作者</dt>
              <dd class="mt-1 text-slate-900">{project.author || "原始数据未提供"}</dd>
            </div>
            <div>
              <dt class="text-slate-500">来源分区</dt>
              <dd class="mt-1 text-slate-900">{project.rawSection || "原始数据未提供"}</dd>
            </div>
            <div>
              <dt class="text-slate-500">来源顺序</dt>
              <dd class="mt-1 text-slate-900">{project.sourceOrder}</dd>
            </div>
            <div>
              <dt class="text-slate-500">是否仍在原列表</dt>
              <dd class="mt-1 text-slate-900">{project.inSource ? "是" : "否"}</dd>
            </div>
          </dl>
          <div class="mt-5 flex flex-wrap gap-3 text-sm">
            {project.url && <a class="rounded-md border border-slate-300 px-3 py-2 text-slate-700 hover:border-slate-500" href={project.url} target="_blank" rel="noreferrer">访问官网</a>}
            <a class="rounded-md border border-slate-300 px-3 py-2 text-slate-700 hover:border-slate-500" href={project.sourceUrl} target="_blank" rel="noreferrer">查看原 README 来源</a>
          </div>
        </section>

        <section class="mt-6 rounded-md border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-semibold tracking-normal">AI 推测分析</h2>
          {!analysis ? (
            <p class="mt-4 leading-7 text-slate-700">AI 分析暂不可用。页面仍展示原始 README 信息和官网摘要。</p>
          ) : analysis.status === "unavailable" ? (
            <p class="mt-4 leading-7 text-slate-700">AI 分析暂不可用：{analysis.unavailableReason}</p>
          ) : (
            <div class="mt-4 space-y-5 text-slate-700">
              <p class="leading-7">{analysis.interpretation}</p>
              <div>
                <h3 class="font-medium text-slate-950">目标用户</h3>
                <p class="mt-2">{analysis.targetUsers.join("、") || "未提供"}</p>
              </div>
              <div>
                <h3 class="font-medium text-slate-950">产品类型</h3>
                <p class="mt-2">{analysis.productTypes.join("、") || "未提供"}</p>
              </div>
              <div>
                <h3 class="font-medium text-slate-950">可借鉴点</h3>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                  {analysis.inspirationPoints.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </div>
          )}
        </section>

        <details class="mt-6 rounded-md border border-slate-200 bg-white p-6">
          <summary class="cursor-pointer text-xl font-semibold tracking-normal">分析依据</summary>
          <div class="mt-4 space-y-4 text-sm leading-7 text-slate-700">
            <p>README 原始简介：{project.rawDescription || "暂缺"}</p>
            {homepageSummary ? (
              <div>
                <p>官网标题：{homepageSummary.title || "未提取到"}</p>
                <p>官网摘要：{homepageSummary.description || homepageSummary.extractedText.slice(0, 240)}</p>
              </div>
            ) : (
              <p>官网不可访问或未提取摘要时，后续 AI 分析只能基于 README 推测。</p>
            )}
          </div>
        </details>
      </article>

      <aside class="space-y-4">
        <section class="rounded-md border border-slate-200 bg-white p-5">
          <h2 class="font-semibold">链接状态</h2>
          <p class="mt-3 text-sm text-slate-700">{linkStatus ? linkStatus.status : "尚未检测"}</p>
          {linkStatus?.checkedAt && <p class="mt-2 text-xs text-slate-500">最近检测：{linkStatus.checkedAt}</p>}
        </section>
        <section class="rounded-md border border-slate-200 bg-white p-5">
          <h2 class="font-semibold">产品模式</h2>
          <p class="mt-3 text-sm text-slate-700">{analysis?.productPatternName || "暂无 AI 推测模式"}</p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
