---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  ArrowLeft,
  ExternalLink,
  FileText,
  GitBranch,
  Link as LinkIcon,
  Sparkles,
} from "lucide-react";
import {
  homepageSummaryByProjectSlug,
  linkStatusByProjectSlug,
  projects,
} from "../../lib/data";
import type { Project } from "../../lib/types";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: Project;
};

const { project } = Astro.props;
const linkStatus = linkStatusByProjectSlug.get(project.slug) ?? null;
const homepageSummary = homepageSummaryByProjectSlug.get(project.slug) ?? null;
const analysis = project.aiAnalysis;
const relatedProjects = analysis?.status === "available"
  ? analysis.relatedProjectSlugs
      .map((slug) => projects.find((item) => item.slug === slug))
      .filter((item): item is Project => Boolean(item))
      .slice(0, 4)
  : [];
const evidenceLabels = {
  homepage_only: "官网摘要",
  readme_and_homepage: "README 与官网摘要",
  readme_only: "README",
};
const linkStatusLabels = {
  ok: "可访问",
  timeout: "检测超时",
  dns_error: "DNS 异常",
  non_html: "非 HTML 页面",
  blocked: "访问受限",
  http_404: "404",
  http_error: "HTTP 异常",
  empty_content: "内容为空",
  invalid_url: "链接无效",
  unknown_error: "未知异常",
};

function formatDateTime(value: string | null | undefined) {
  if (!value) {
    return "暂无记录";
  }

  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(value));
}

const hasAnalysis = analysis?.status === "available";
const primaryTypes = hasAnalysis ? analysis.productTypes.slice(0, 4) : [];
const primaryUsers = hasAnalysis ? analysis.targetUsers.slice(0, 3) : [];
const homepageExcerpt = homepageSummary
  ? homepageSummary.description || homepageSummary.extractedText.slice(0, 260)
  : null;
---

<BaseLayout
  title={`${project.name} | Indie Products Map`}
  description={project.rawDescription || `${project.name} 的独立产品详情。`}
  canonicalPath={`/projects/${project.slug}/`}
>
  <main>
    <section class="border-b border-slate-200 bg-white/65">
      <div class="mx-auto max-w-6xl px-6 py-8 sm:py-10">
        <a class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-emerald-700" href="/projects">
          <ArrowLeft aria-hidden="true" className="h-4 w-4" />
          返回项目列表
        </a>

        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-stretch">
          <div class="rounded-md border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="font-data text-xs uppercase tracking-[0.18em] text-emerald-700">Project dossier</p>
            <h1 class="font-display mt-3 break-words text-4xl font-semibold leading-tight tracking-normal text-slate-950 sm:text-5xl">
              {project.name}
            </h1>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-700">{project.rawDescription || "原始简介暂缺。"}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {primaryTypes.length > 0
                ? primaryTypes.map((type) => <span class="max-w-full break-words rounded-md bg-slate-100 px-2 py-1 text-sm text-slate-600">{type}</span>)
                : <span class="rounded-md bg-slate-100 px-2 py-1 text-sm text-slate-600">暂无产品类型</span>}
              {analysis?.lowConfidence && <span class="rounded-md bg-amber-50 px-2 py-1 text-sm text-amber-700">低置信度 AI 推测</span>}
              {!hasAnalysis && <span class="rounded-md bg-slate-100 px-2 py-1 text-sm text-slate-600">暂无 AI 分析</span>}
            </div>
            <div class="mt-7 flex flex-wrap gap-3 text-sm">
              {project.url && (
                <a class="inline-flex items-center gap-2 rounded-md bg-slate-950 px-4 py-2 font-medium text-white hover:bg-slate-800" href={project.url} target="_blank" rel="noreferrer">
                  访问官网
                  <ExternalLink aria-hidden="true" className="h-4 w-4" />
                </a>
              )}
              <a class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-4 py-2 font-medium text-slate-700 hover:border-slate-500 hover:text-slate-950" href={project.sourceUrl} target="_blank" rel="noreferrer">
                原 README 来源
                <ExternalLink aria-hidden="true" className="h-4 w-4" />
              </a>
            </div>
          </div>

          <aside class="rounded-md bg-slate-950 p-6 text-white shadow-sm">
            <p class="font-data text-xs uppercase tracking-[0.18em] text-slate-400">Status panel</p>
            <dl class="mt-6 grid gap-5 text-sm">
              <div>
                <dt class="text-slate-400">链接状态</dt>
                <dd class="mt-1 text-lg font-semibold">{linkStatus ? linkStatusLabels[linkStatus.status] : "尚未检测"}</dd>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <dt class="text-slate-400">原列表</dt>
                  <dd class="mt-1 font-semibold">{project.inSource ? "仍在收录" : "已不在原列表"}</dd>
                </div>
                <div>
                  <dt class="text-slate-400">来源序号</dt>
                  <dd class="font-data mt-1 font-semibold">{project.sourceOrder}</dd>
                </div>
              </div>
              <div>
                <dt class="text-slate-400">最近检测</dt>
                <dd class="mt-1 font-semibold">{formatDateTime(linkStatus?.checkedAt)}</dd>
              </div>
              <div>
                <dt class="text-slate-400">AI 分析时间</dt>
                <dd class="mt-1 font-semibold">{formatDateTime(analysis?.analyzedAt)}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <article class="min-w-0 space-y-6">
        <section class="rounded-md border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-5">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-emerald-50 text-emerald-700">
                <FileText aria-hidden="true" className="h-4 w-4" />
              </span>
              <div>
                <p class="text-sm font-medium text-emerald-700">原始信息</p>
                <h2 class="font-display mt-1 text-2xl font-semibold tracking-normal text-slate-950">README 收录记录</h2>
              </div>
            </div>
          </div>

          <div class="grid gap-0 md:grid-cols-[180px_minmax(0,1fr)]">
            <div class="border-b border-slate-200 px-6 py-4 md:border-b-0 md:border-r">
              <p class="text-sm font-medium text-slate-950">原始简介</p>
            </div>
            <div class="border-b border-slate-200 px-6 py-4">
              <p class="break-words text-sm leading-7 text-slate-700">{project.rawDescription || "暂缺"}</p>
            </div>

            <div class="border-b border-slate-200 px-6 py-4 md:border-r">
              <p class="text-sm font-medium text-slate-950">作者</p>
            </div>
            <div class="border-b border-slate-200 px-6 py-4">
              {project.authorUrl ? (
                <a class="inline-flex max-w-full items-center gap-2 break-words text-sm text-emerald-700 hover:text-emerald-900" href={project.authorUrl} target="_blank" rel="noreferrer">
                  {project.author || "原始数据未提供"}
                  <ExternalLink aria-hidden="true" className="h-3.5 w-3.5 shrink-0" />
                </a>
              ) : (
                <p class="break-words text-sm text-slate-700">{project.author || "原始数据未提供"}</p>
              )}
            </div>

            <div class="border-b border-slate-200 px-6 py-4 md:border-r">
              <p class="text-sm font-medium text-slate-950">来源分区</p>
            </div>
            <div class="border-b border-slate-200 px-6 py-4">
              <p class="break-words text-sm text-slate-700">{project.rawSection || "原始数据未提供"}</p>
            </div>

            <div class="border-slate-200 px-6 py-4 md:border-r">
              <p class="text-sm font-medium text-slate-950">记录时间</p>
            </div>
            <div class="px-6 py-4">
              <dl class="grid gap-3 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-slate-500">首次收录</dt>
                  <dd class="mt-1 text-slate-900">{formatDateTime(project.firstSeenAt)}</dd>
                </div>
                <div>
                  <dt class="text-slate-500">原始信息更新</dt>
                  <dd class="mt-1 text-slate-900">{formatDateTime(project.rawUpdatedAt)}</dd>
                </div>
              </dl>
            </div>
          </div>
        </section>

        <section class="rounded-md border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-6 py-5">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-emerald-50 text-emerald-700">
                <Sparkles aria-hidden="true" className="h-4 w-4" />
              </span>
              <div>
                <p class="text-sm font-medium text-emerald-700">AI 推测</p>
                <h2 class="font-display mt-1 text-2xl font-semibold tracking-normal text-slate-950">产品理解记录</h2>
              </div>
            </div>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600">以下内容由 AI 基于 README 和官网摘要生成，只作为产品灵感参考，不代表项目事实判断。</p>
          </div>
          {!analysis ? (
            <p class="px-6 py-6 leading-7 text-slate-700">AI 分析暂不可用。页面仍展示原始 README 信息和官网摘要。</p>
          ) : analysis.status === "unavailable" ? (
            <p class="px-6 py-6 leading-7 text-slate-700">AI 分析暂不可用：{analysis.unavailableReason}</p>
          ) : (
            <div class="space-y-0 text-slate-700">
              {analysis.lowConfidence && (
                <p class="border-b border-amber-200 bg-amber-50 px-6 py-4 text-sm text-amber-700">
                  该分析依据较少，阅读时应优先参考原始信息。
                </p>
              )}
              <div class="grid gap-0 md:grid-cols-[180px_minmax(0,1fr)]">
                <div class="border-b border-slate-200 px-6 py-5 md:border-r">
                  <h3 class="text-sm font-semibold text-slate-950">一句话摘要</h3>
                </div>
                <div class="border-b border-slate-200 px-6 py-5">
                  <p class="break-words leading-7">{analysis.summary}</p>
                </div>

                <div class="border-b border-slate-200 px-6 py-5 md:border-r">
                  <h3 class="text-sm font-semibold text-slate-950">产品解读</h3>
                </div>
                <div class="border-b border-slate-200 px-6 py-5">
                  <p class="break-words leading-7">{analysis.interpretation}</p>
                </div>

                <div class="border-b border-slate-200 px-6 py-5 md:border-r">
                  <h3 class="text-sm font-semibold text-slate-950">目标用户</h3>
                </div>
                <div class="border-b border-slate-200 px-6 py-5">
                  <div class="flex flex-wrap gap-2">
                    {primaryUsers.map((item) => <span class="max-w-full break-words rounded-md bg-slate-100 px-2 py-1 text-sm text-slate-600">{item}</span>)}
                  </div>
                </div>

                <div class="border-b border-slate-200 px-6 py-5 md:border-r">
                  <h3 class="text-sm font-semibold text-slate-950">可借鉴点</h3>
                </div>
                <div class="border-b border-slate-200 px-6 py-5">
                  <ul class="grid gap-2 text-sm leading-6">
                    {analysis.inspirationPoints.map((point) => <li class="rounded-md bg-slate-50 px-3 py-2">{point}</li>)}
                  </ul>
                </div>

                <div class="border-b border-slate-200 px-6 py-5 md:border-r">
                  <h3 class="text-sm font-semibold text-slate-950">灵感问题</h3>
                </div>
                <div class="border-b border-slate-200 px-6 py-5">
                  <ul class="grid gap-2 text-sm leading-6">
                    {analysis.inspirationQuestions.map((question) => <li class="rounded-md bg-slate-50 px-3 py-2">{question}</li>)}
                  </ul>
                </div>

                {analysis.monetization && (
                  <>
                    <div class="border-slate-200 px-6 py-5 md:border-r">
                      <h3 class="text-sm font-semibold text-slate-950">商业化推测</h3>
                    </div>
                    <div class="px-6 py-5">
                      <div class="flex flex-wrap gap-2">
                        {analysis.monetization.methods.map((item) => <span class="max-w-full break-words rounded-md bg-slate-100 px-2 py-1 text-sm text-slate-600">{item}</span>)}
                      </div>
                      {analysis.monetization.note && <p class="mt-3 text-sm leading-6 text-slate-600">{analysis.monetization.note}</p>}
                    </div>
                  </>
                )}
              </div>
            </div>
          )}
        </section>

        <details class="rounded-md border border-slate-200 bg-white shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5">
            <span>
              <span class="text-sm font-medium text-emerald-700">依据</span>
              <span class="font-display mt-1 block text-2xl font-semibold tracking-normal text-slate-950">分析依据</span>
            </span>
            <span class="font-data text-xs text-slate-500">展开</span>
          </summary>
          <div class="border-t border-slate-200 px-6 py-5 text-sm leading-7 text-slate-700">
            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <h3 class="font-semibold text-slate-950">README 原始简介</h3>
                <p class="mt-2 break-words">{project.rawDescription || "暂缺"}</p>
              </div>
              <div>
                <h3 class="font-semibold text-slate-950">官网摘要</h3>
                {homepageSummary ? (
                  <>
                    <p class="mt-2 break-words">标题：{homepageSummary.title || "未提取到"}</p>
                    <p class="mt-1 break-words">{homepageExcerpt}</p>
                  </>
                ) : (
                  <p class="mt-2">官网不可访问或未提取摘要时，AI 分析只能基于 README 推测。</p>
                )}
              </div>
            </div>
          </div>
        </details>
      </article>

      <aside class="space-y-4 lg:sticky lg:top-4 lg:self-start">
        <section class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <LinkIcon aria-hidden="true" className="h-4 w-4 text-emerald-700" />
            <h2 class="font-semibold text-slate-950">链接记录</h2>
          </div>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-slate-500">状态</dt>
              <dd class="mt-1 text-slate-900">{linkStatus ? linkStatusLabels[linkStatus.status] : "尚未检测"}</dd>
            </div>
            {linkStatus?.httpStatus && (
              <div>
                <dt class="text-slate-500">HTTP</dt>
                <dd class="font-data mt-1 text-slate-900">{linkStatus.httpStatus}</dd>
              </div>
            )}
            <div>
              <dt class="text-slate-500">最终地址</dt>
              <dd class="mt-1 break-words text-slate-900">{linkStatus?.finalUrl || project.url || "暂无"}</dd>
            </div>
          </dl>
        </section>

        <section class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <Sparkles aria-hidden="true" className="h-4 w-4 text-emerald-700" />
            <h2 class="font-semibold text-slate-950">分析记录</h2>
          </div>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-slate-500">分析时间</dt>
              <dd class="mt-1 text-slate-900">{formatDateTime(analysis?.analyzedAt)}</dd>
            </div>
            <div>
              <dt class="text-slate-500">分析依据</dt>
              <dd class="mt-1 text-slate-900">
                {analysis?.status === "available" ? analysis.evidenceTypes.map((type) => evidenceLabels[type]).join("、") : "暂无"}
              </dd>
            </div>
            <div>
              <dt class="text-slate-500">是否过期</dt>
              <dd class="mt-1 text-slate-900">{analysis?.stale ? "需要重新分析" : "当前记录"}</dd>
            </div>
          </dl>
        </section>

        <section class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <GitBranch aria-hidden="true" className="h-4 w-4 text-emerald-700" />
            <h2 class="font-semibold text-slate-950">记录标识</h2>
          </div>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-slate-500">Slug</dt>
              <dd class="font-data mt-1 break-words text-slate-900">{project.slug}</dd>
            </div>
            <div>
              <dt class="text-slate-500">项目 ID</dt>
              <dd class="font-data mt-1 break-words text-slate-900">{project.id}</dd>
            </div>
          </dl>
        </section>

        {relatedProjects.length > 0 && (
          <section class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="font-semibold text-slate-950">相关项目</h2>
            <div class="mt-4 space-y-3">
              {relatedProjects.map((item) => (
                <a class="block rounded-md bg-slate-50 px-3 py-2 text-sm font-medium text-slate-950 hover:text-emerald-700" href={`/projects/${item.slug}`}>
                  {item.name}
                </a>
              ))}
            </div>
          </section>
        )}
      </aside>
    </div>
  </main>
</BaseLayout>
