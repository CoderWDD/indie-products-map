---
import { Database, Filter, Search, Sparkles } from "lucide-react";
import { ProjectExplorer } from "../../components/ProjectExplorer";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../lib/data";

const initialQuery = Astro.url.searchParams.get("q") ?? "";
const analyzedCount = projects.filter((project) => project.aiAnalysis?.status === "available").length;
const activeProjects = projects.filter((project) => project.inSource).length;
const analysisCoverage = projects.length > 0 ? Math.round((analyzedCount / projects.length) * 100) : 0;
---

<BaseLayout title="项目列表 | Indie Products Map" description="按原 README 顺序展示独立产品项目。">
  <main class="overflow-x-clip">
    <section class="border-b border-slate-200 bg-white/65">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 py-8 sm:py-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-stretch">
        <div class="rounded-md border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <p class="font-data text-xs uppercase tracking-[0.18em] text-emerald-700">Project explorer</p>
          <h1 class="font-display mt-3 max-w-3xl text-4xl font-semibold leading-tight tracking-normal text-slate-950 sm:text-5xl">
            查找独立产品案例
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-700">
            用关键词、产品类型、目标用户和商业化方式缩小样本范围。原始 README 信息和 AI 推测分开呈现，适合快速找方向、看定位、拆人群。
          </p>

          <div class="mt-7 grid gap-3 text-sm sm:grid-cols-3">
            <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-3">
              <Search aria-hidden="true" className="h-4 w-4 text-emerald-700" />
              <p class="mt-3 font-semibold text-slate-950">关键词搜索</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">项目名、作者、简介和 AI 摘要</p>
            </div>
            <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-3">
              <Filter aria-hidden="true" className="h-4 w-4 text-emerald-700" />
              <p class="mt-3 font-semibold text-slate-950">多维筛选</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">类型、人群、商业化方式</p>
            </div>
            <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-3">
              <Sparkles aria-hidden="true" className="h-4 w-4 text-emerald-700" />
              <p class="mt-3 font-semibold text-slate-950">AI 推测</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">只作产品灵感参考</p>
            </div>
          </div>
        </div>

        <aside class="rounded-md bg-slate-950 p-6 text-white shadow-sm">
          <p class="font-data text-xs uppercase tracking-[0.18em] text-slate-400">Explorer state</p>
          <dl class="mt-6 grid gap-5 text-sm">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <dt class="text-slate-400">项目总数</dt>
                <dd class="font-data mt-1 text-2xl font-semibold">{projects.length}</dd>
              </div>
              <div>
                <dt class="text-slate-400">仍在原列表</dt>
                <dd class="font-data mt-1 text-2xl font-semibold">{activeProjects}</dd>
              </div>
            </div>
            <div>
              <dt class="text-slate-400">AI 分析</dt>
              <dd class="mt-1 flex items-end gap-2">
                <span class="font-data text-2xl font-semibold">{analyzedCount}</span>
                <span class="pb-1 text-xs text-slate-400">覆盖 {analysisCoverage}%</span>
              </dd>
            </div>
            <div class="rounded-md border border-white/15 px-4 py-3">
              <Database aria-hidden="true" className="h-4 w-4 text-white/70" />
              <p class="mt-3 text-sm font-semibold">默认沿用原 README 顺序</p>
              <p class="mt-1 text-xs leading-5 text-white/60">搜索结果会继续应用筛选和排序。</p>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-6 py-8 sm:py-10">
      <ProjectExplorer client:load initialQuery={initialQuery} />
    </div>
  </main>
</BaseLayout>
