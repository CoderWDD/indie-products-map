---
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../lib/data";
---

<BaseLayout title="项目列表 | Indie Products Map" description="按原 README 顺序展示独立产品项目。">
  <main class="mx-auto max-w-6xl px-6 py-10">
    <section>
      <p class="text-sm font-medium text-emerald-700">项目列表</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-normal">按来源顺序浏览项目</h1>
      <p class="mt-4 max-w-3xl leading-7 text-slate-700">
        当前页面是静态列表骨架。搜索、筛选和排序交互会在后续任务卡实现；默认顺序沿用原 README 来源顺序。
      </p>
    </section>

    <section class="mt-8 rounded-md border border-slate-200 bg-white p-4">
      <form action="/projects" method="get" class="grid gap-3 md:grid-cols-[1fr_auto]">
        <label class="sr-only" for="q">搜索项目</label>
        <input id="q" name="q" class="rounded-md border border-slate-300 px-4 py-3 outline-none focus:border-emerald-600" placeholder="搜索会在 T9 接入 Fuse.js" />
        <button class="rounded-md bg-slate-950 px-5 py-3 text-sm font-medium text-white" type="submit">搜索</button>
      </form>
    </section>

    <section class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3" aria-label="项目卡片">
      {projects.map((project) => <ProjectCard project={project} />)}
    </section>
  </main>
</BaseLayout>
