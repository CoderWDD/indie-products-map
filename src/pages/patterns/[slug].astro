---
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { patterns, projectsBySlug } from "../../lib/data";
import type { Pattern } from "../../lib/types";

export function getStaticPaths() {
  return patterns.map((pattern) => ({
    params: { slug: pattern.slug },
    props: { pattern },
  }));
}

type Props = {
  pattern: Pattern;
};

const { pattern } = Astro.props;
const patternProjects = pattern.projectSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project) => Boolean(project));
const representativeProjects = pattern.representativeProjectSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project) => Boolean(project));
---

<BaseLayout title={`${pattern.name} | Indie Products Map`} description={pattern.description}>
  <main class="mx-auto max-w-6xl px-6 py-10">
    <section class="max-w-3xl">
      <p class="text-sm font-medium text-emerald-700">产品模式</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-normal">{pattern.name}</h1>
      <p class="mt-4 text-lg leading-8 text-slate-700">{pattern.description}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {pattern.keywords.map((keyword) => <span class="rounded-md bg-white px-3 py-1 text-sm text-slate-600">{keyword}</span>)}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold tracking-normal">代表项目</h2>
      <p class="mt-2 text-sm text-slate-500">代表项目只说明该模式的典型信息，不代表项目好坏。</p>
      <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {representativeProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold tracking-normal">全部项目</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {patternProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
</BaseLayout>
