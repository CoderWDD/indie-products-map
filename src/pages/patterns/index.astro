---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { patterns } from "../../lib/data";
---

<BaseLayout title="产品模式 | Indie Products Map" description="按产品模式浏览独立产品灵感。">
  <main class="mx-auto max-w-6xl px-6 py-10">
    <section class="max-w-3xl">
      <p class="text-sm font-medium text-emerald-700">产品模式</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-normal">产品模式地图</h1>
      <p class="mt-4 leading-7 text-slate-700">
        产品模式由 AI 聚类生成，是辅助理解产品形态的推测信息，不代表事实判断或项目好坏。
      </p>
    </section>

    {patterns.length === 0 ? (
      <section class="mt-8 rounded-md border border-dashed border-slate-300 bg-white p-8 text-slate-600">
        暂无产品模式数据。后续运行 AI 分析和聚类后，此页会按当前 JSON 数据生成模式入口。
      </section>
    ) : (
      <section class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {patterns.map((pattern) => (
          <a class="rounded-md border border-slate-200 bg-white p-5 shadow-sm hover:border-emerald-300" href={`/patterns/${pattern.slug}`}>
            <div class="text-sm text-slate-500">{pattern.icon}</div>
            <h2 class="mt-3 text-lg font-semibold">{pattern.name}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-700">{pattern.description}</p>
            <p class="mt-4 text-sm text-slate-500">{pattern.projectSlugs.length} 个项目</p>
          </a>
        ))}
      </section>
    )}
  </main>
</BaseLayout>
