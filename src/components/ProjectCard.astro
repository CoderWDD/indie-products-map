---
import { ExternalLink } from "lucide-react";
import type { Project } from "../lib/types";

type Props = {
  project: Project;
};

const { project } = Astro.props;
const analysis = project.aiAnalysis;
const interpretation = analysis?.interpretation
  ? truncateText(analysis.interpretation, 92)
  : null;

function truncateText(value: string, maxLength: number) {
  return value.length > maxLength ? `${value.slice(0, maxLength)}...` : value;
}
---

<article class="flex min-h-72 min-w-0 flex-col overflow-hidden rounded-md border border-slate-200 bg-white shadow-sm">
  <div class="flex min-w-0 items-start justify-between gap-4 border-b border-slate-200 px-5 py-4">
    <div class="min-w-0">
      <p class="font-data text-[0.68rem] uppercase tracking-[0.16em] text-slate-500">Project record</p>
      <h2 class="mt-2 min-w-0 break-words text-lg font-semibold leading-7 tracking-normal text-slate-950">
        <a class="break-words hover:text-emerald-700" href={`/projects/${project.slug}`}>{project.name}</a>
      </h2>
      <p class="mt-1 min-w-0 break-words text-sm text-slate-500">
        {project.author ? `作者：${project.author}` : "作者：原始数据未提供"}
      </p>
    </div>
    {project.url && (
      <a
        aria-label={`访问 ${project.name} 官网`}
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 text-slate-500 hover:text-slate-950"
        href={project.url}
        target="_blank"
        rel="noreferrer"
        title="访问官网"
      >
        <ExternalLink aria-hidden="true" className="h-4 w-4" />
      </a>
    )}
  </div>

  <div class="grid min-w-0 flex-1 content-start gap-4 px-5 py-4">
    <section class="min-w-0">
      <p class="text-xs font-medium text-slate-500">原始简介</p>
      <p class="mt-2 min-w-0 break-words text-sm leading-6 text-slate-700 sm:line-clamp-3">{project.rawDescription || "原始简介暂缺。"}</p>
    </section>

    {interpretation && (
      <section class="min-w-0 rounded-md bg-slate-50 px-3 py-3">
        <p class="text-xs font-medium text-emerald-700">AI 推测</p>
        <p class="mt-2 min-w-0 break-words text-sm leading-6 text-slate-600">{interpretation}</p>
      </section>
    )}
  </div>

  <div class="mt-auto flex min-w-0 flex-wrap gap-2 border-t border-slate-200 px-5 py-4 text-xs">
    {analysis?.productTypes.slice(0, 3).map((type) => (
      <span class="max-w-full break-words rounded-md bg-slate-100 px-2 py-1 text-slate-600">{type}</span>
    ))}
    {analysis?.lowConfidence && <span class="max-w-full break-words rounded-md bg-amber-50 px-2 py-1 text-amber-700">低置信度 AI 推测</span>}
    {!analysis && <span class="max-w-full break-words rounded-md bg-slate-100 px-2 py-1 text-slate-600">暂无 AI 分析</span>}
  </div>
</article>
