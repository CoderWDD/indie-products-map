---
type Props = {
  compact?: boolean;
};

const { compact = false } = Astro.props;
const slogan = "从中文独立产品里，找下一次动手的方向。";
---

<span class="inline-flex min-w-0 items-center gap-3">
  <span
    class="relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-md border border-slate-200 bg-slate-950 text-white shadow-sm"
    aria-hidden="true"
  >
    <svg class="h-8 w-8" viewBox="0 0 64 64" fill="none" role="img">
      <path d="M14 18H50" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
      <path d="M22 30H42" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
      <path d="M32 18V48" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
      <path d="M20 48H44" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
      <circle cx="48" cy="16" r="5" fill="#245bff" />
      <circle cx="16" cy="48" r="3" fill="#d78a00" />
    </svg>
  </span>
  <span class="min-w-0">
    <span class:list={["font-display block truncate font-semibold tracking-normal text-slate-950", compact ? "text-lg" : "text-xl"]}>
      Indie Products Map
    </span>
    <span class="block truncate text-xs text-slate-500">{slogan}</span>
  </span>
</span>
